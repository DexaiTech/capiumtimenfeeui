# Base URL of the API, including the version prefix.
# In development Vite proxies /api to http://localhost:8000 (see vite.config.ts), so the
# browser sees a single origin and the refresh cookie (scoped to /api/v1/auth) is same-origin.
VITE_API_URL=/api/v1

# Where the dev server proxies /api (read by vite.config.ts, not exposed to the browser).
# API_PROXY_TARGET=http://localhost:8000

# Production with the API on its own subdomain of the same site as the UI:
# VITE_API_URL=https://api.example.co.uk/api/v1
# The API's FRONTEND_URL, BACKEND_URL and CORS_ORIGINS must then name the real UI and API origins.
